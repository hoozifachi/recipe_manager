# Copy to .env.local and fill in from your Supabase project:
# Dashboard -> Settings -> API Keys -> the `default` publishable key.
#
# If you are running the bundled Docker-free stack instead, `npm run stack:up`
# generates .env.local for you with the local stack's own key and gateway URL.
#
# These are safe to expose in the browser. The publishable key is public by
# design; Row Level Security is what actually protects the data, and it is
# enforced in the database rather than the client.
#
# Do NOT put a secret key here. It bypasses RLS entirely.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key